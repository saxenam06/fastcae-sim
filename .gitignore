# Session and editor state
.remember/
.claude/settings.local.json
.vscode/
.idea/

# Python environments and caches
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# The web UI's packages and build (rebuilt by npm ci and npm run build)
web/node_modules/
web/dist/
*.tsbuildinfo

# Archived code, kept only on the engineer's laptop: archive/web/ (the UI's old views) and
# archive/src/ (retired Python). Git's history keeps what was committed: the UI's first views
# at 61e51c8, under web/archive/. A bare rule (the engineer, 9 Oct: VS Code then greys the
# folder), so it also matches docs/archive/, which the next line takes back: those docs are
# tracked.
archive/
!/docs/archive/

# Credentials: read from the environment, never committed
.env

# Data: third-party part inputs (licensed) and run outputs (rebuilt by running). Anchored to the
# root: checks/data/ (the example contracts) and web/src/data/ (the UI's Data tab) are tracked.
/assets/
/results/
/data/

# OS noise
Thumbs.db
.DS_Store
